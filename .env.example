# --- Kite Connect (https://developers.kite.trade) ---
KITE_API_KEY=
KITE_API_SECRET=
# Normally leave these empty: token_service.py writes data/token.json after your daily login.
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# --- Telegram alerts (create a bot with @BotFather; get your chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Daily login callback ---
# Domain whose A record points at your server's static IP. In the Kite app settings
# set the Redirect URL to https://<BOT_DOMAIN>/kite/callback
BOT_DOMAIN=bot.example.com
LOGIN_PROMPT_TIME=08:30

# --- Trading ---
PRODUCT=MIS
PAPER_CAPITAL=500000
MAX_RISK_PER_TRADE_PCT=0.02
MAX_DAILY_LOSS_PCT=0.03
MAX_LOTS=10
# Seconds between option-chain refreshes (each refresh is recorded to SQLite)
CHAIN_INTERVAL_S=1
# Required for --live
LIVE_TRADING_CONFIRM=NO

# --- Optional: live orders feed to a Google Sheet (see deploy/google_sheets_script.gs) ---
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# Backtest assumption: SENSEX ATM implied vol = India VIX x this. Measure it: python calibrate.py
BT_IV_SCALE=0.95

# Stream ATM+/-10 strikes in FULL mode (tick-level OI, volume, bid/ask) and record to the `flow` table. 0 = off.
STREAM_FULL=1

# --- data cadence (defaults shown) ---
# LOOP_INTERVAL_S=1            # decision loop
# CHAIN_INTERVAL_S=1           # chain rebuild (from WebSocket ticks)
# CHAIN_RECORD_EVERY_S=10      # full chain stored this often
# FLOW_RECORD_EVERY_S=1        # ATM+/-FLOW_STRIKES rows stored this often
# FLOW_STRIKES=5
# STREAM_CHAIN=1               # 0 = REST polling only (then CHAIN_INTERVAL_S>=3)
# FLOW_RETENTION_DAYS=30       # 0 = keep forever

# --- account size ---
# PAPER_CAPITAL=15000          # try 15000, 50000 and 500000 in paper mode (live uses your Kite cash)
# CAPITAL_PROFILE=auto         # auto: below Rs 3.75 lakh one affordable lot may trade (see capital_check.py)

# Your Zerodha user id (e.g. AB1234): the token service refuses a login from any other account
# KITE_USER_ID=

# Paper-only exploration of the scanner's best setups (so paper mode always produces trades). 0 = off.
# PAPER_EXPLORE=1
# EXPLORE_MIN_SCORE=60
# EXPLORE_MAX_TRADES=4
