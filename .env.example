# --- Kite Connect (https://developers.kite.trade) ---
KITE_API_KEY=
KITE_API_SECRET=
# Normally leave these empty: token_service.py writes data/token.json after your daily login.
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=

# --- Telegram alerts (create a bot with @BotFather; get your chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Daily login callback ---
# Domain whose A record points at your server's static IP. In the Kite app settings
# set the Redirect URL to https://<BOT_DOMAIN>/kite/callback
BOT_DOMAIN=bot.example.com
LOGIN_PROMPT_TIME=08:30

# --- Trading ---
PRODUCT=MIS
PAPER_CAPITAL=500000
MAX_RISK_PER_TRADE_PCT=0.02
MAX_DAILY_LOSS_PCT=0.03
MAX_LOTS=10
# Seconds between option-chain refreshes (each refresh is recorded to SQLite)
CHAIN_INTERVAL_S=1
# Required for --live
LIVE_TRADING_CONFIRM=NO

# --- Optional: live orders feed to a Google Sheet (see deploy/google_sheets_script.gs) ---
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# Backtest assumption: SENSEX ATM implied vol = India VIX x this. Measure it: python calibrate.py
BT_IV_SCALE=0.95

# Stream ATM+/-10 strikes in FULL mode (tick-level OI, volume, bid/ask) and record to the `flow` table. 0 = off.
STREAM_FULL=1

# --- data cadence (defaults shown) ---
# LOOP_INTERVAL_S=1            # decision loop
# CHAIN_INTERVAL_S=1           # chain rebuild (from WebSocket ticks)
# CHAIN_RECORD_EVERY_S=10      # full chain stored this often
# FLOW_RECORD_EVERY_S=1        # ATM+/-FLOW_STRIKES rows stored this often
# FLOW_STRIKES=5
# STREAM_CHAIN=1               # 0 = REST polling only (then CHAIN_INTERVAL_S>=3)
# FLOW_RETENTION_DAYS=30       # 0 = keep forever

# --- account size ---
# PAPER_CAPITAL=15000          # try 15000, 50000 and 500000 in paper mode (live uses your Kite cash)
# CAPITAL_PROFILE=auto         # auto: below Rs 3.75 lakh one affordable lot may trade (see capital_check.py)

# Your Zerodha user id (e.g. AB1234): the token service refuses a login from any other account
# KITE_USER_ID=

# Paper-only exploration of the scanner's best setups (so paper mode always produces trades). 0 = off.
# PAPER_EXPLORE=1
# EXPLORE_MIN_SCORE=60
# EXPLORE_MAX_TRADES=4

# Rupee rules on the combined multi-leg P&L (0 disables). Trailing profit stop arms at, and never exits below,
# TRAIL_MIN_PROFIT_RS; POSITION_STOP_RS is a combined stop-loss ceiling.
TRAIL_MIN_PROFIT_RS=2000
POSITION_STOP_RS=2000

# Exit engine (combined multi-leg P&L). EXIT_ENGINE=0 falls back to the older percentage rules.
EXIT_ENGINE=1
TRAIL_GIVEBACK=0.40          # share of peak profit the trail may give back before market adaptation
TRAIL_GIVEBACK_MIN=0.15
TRAIL_GIVEBACK_MAX=0.60
TRAIL_LADDER_STEP_RS=1000    # floor steps up at 3000, 4000, ...
TRAIL_LADDER_LAG=2           # floor sits this many steps behind the highest milestone
TRAIL_ADAPT=1                # tighten/widen from OI, PCR, max pain, VIX, theta window, reversal signals
REQUIRE_REACHABLE_ARM=1      # entry gate: max profit must exceed TRAIL_MIN_PROFIT_RS
# Entry filter (direction + IV skew + OI build-up must agree)
ENTRY_FILTER=1
ENTRY_FILTER_STRICT=1        # missing data rejects the entry
SKEW_BULL_MAX=8
SKEW_BEAR_MIN=-1
SKEW_NEUTRAL_ABS=8
# Structure-scaled exits: arm = min(TRAIL_MIN_PROFIT_RS, TRAIL_ARM_FRAC x max profit); stop = min(POSITION_STOP_RS,
# variant sl_frac x max loss). TRAIL_ARM_FRAC=0 restores the fixed rupee arm.
TRAIL_ARM_FRAC=0.35
# Entry gates on costs: arm level >= MIN_ARM_COST_MULT x round-trip charges; same-day (MIS) premium selling needs
# net theta/day x THETA_CAPTURE_FRAC x session left >= MIN_THETA_COST_MULT x charges.
MIN_ARM_COST_MULT=2
THETA_CAPTURE_FRAC=0.5
MIN_THETA_COST_MULT=1.5
# Exploration skips a strategy family (template + trend filter) whose shadow trades over the last EXPLORE_FWD_DAYS
# are clearly losing: >= EXPLORE_FWD_MIN_TRADES trades and a t-stat of the mean net <= EXPLORE_FWD_MAX_T. 0 = off.
EXPLORE_FWD_MIN_TRADES=20
EXPLORE_FWD_DAYS=60
EXPLORE_FWD_MAX_T=-1.0
# Accounts below this trade single-leg structures only (one option bought, then sold). Default Rs 1,00,000.
MULTI_LEG_MIN_CAPITAL=100000
# 1 = also paper-explore scanner setups when validated strategies exist but none fired (more, worse paper trades)
EXPLORE_WITH_APPROVED=0
