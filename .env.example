# SENSEX PRO environment. Copy to .env on the VM (chmod 600). NEVER commit .env.
# Trading, risk and strategy parameters are in config/*.yaml, not here.

# --- Kite Connect (https://developers.kite.trade) ---
KITE_API_KEY=
KITE_API_SECRET=
# Normally leave these empty: token_service.py writes data/token.json after your daily login.
KITE_ACCESS_TOKEN=
KITE_REQUEST_TOKEN=
# Your Zerodha user id (e.g. AB1234): the token service refuses a login from any other account
KITE_USER_ID=

# --- Telegram alerts and commands (@BotFather; chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: extra Telegram user ids allowed to use /mode, /kill, /resetkill (comma separated)
TELEGRAM_ADMIN_IDS=

# --- Daily login callback (Caddy serves https://<BOT_DOMAIN>/kite/callback) ---
BOT_DOMAIN=bot.example.com
LOGIN_PROMPT_TIME=08:30

# --- Trading ---
PRODUCT=MIS
# Paper account size. Risk limits in config/risk.yaml scale with it (x PAPER_CAPITAL / 40000). Live uses Kite cash.
PAPER_CAPITAL=200000
# Upper bound on lots per order (Telegram /lots sets each index; the premium cap may reduce it further)
MAX_LOTS=10
# Master switch for LIVE. Both this AND a confirmed Telegram /mode live are required.
LIVE_TRADING_CONFIRM=NO
# No longer read by SENSEX PRO (config/risk.yaml governs): MAX_RISK_PER_TRADE_PCT, MAX_DAILY_LOSS_PCT, CHAIN_INTERVAL_S

# --- Google Sheet feed (deploy/google_sheets_script.gs): Orders / Trades / Status / Health / Log tabs ---
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# --- Trading report page: ONE Cloud Storage object gs://REPORT_GCS_BUCKET/r/<REPORT_TOKEN>/index.html ---
REPORT_TOKEN=
REPORT_GCS_BUCKET=

# --- Optional ---
# DATABASE_URL=sqlite:///data/sxbot.db
# DATA_DIR=data
# LOG_DIR=logs
